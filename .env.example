# 本文件只展示变量名和本地开发默认值，不得放真实服务器密码。
SWARMOS_CONFIG=./configs/config.yaml
SWARMOS_DATABASE_DSN=postgres://swarmos:swarmos@127.0.0.1:55432/swarmos?sslmode=disable
SWARMOS_REDIS_ADDR=127.0.0.1:56379
SWARMOS_REDIS_PASSWORD=
SWARMOS_NATS_URL=nats://127.0.0.1:54222
SWARMOS_WORKER_DURABLE=swarmos-workers
SWARMOS_WORKER_CONCURRENCY=4
SWARMOS_WORKER_METRICS_ADDR=127.0.0.1:9465
SWARMOS_WEB_DIR=./web/dist
SWARMOS_TRACE_SAMPLE_RATIO=0.1
# 可选：配置后 Trace 通过 OTLP/gRPC 发往 OpenTelemetry Collector。
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
# OpenAI 官方 SDK 自动读取此变量；切勿提交真实值。
OPENAI_API_KEY=
